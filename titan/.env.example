# Groq API Credentials (required for fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (optional, falls back to mock news/geopolitical fetcher if empty)
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration (Neon serverless PostgreSQL or any Postgres instance)
# Leave blank to fall back to a local SQLite file (titan_dev.db) automatically
DATABASE_URL=postgresql://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# Slack Webhook URL for human approval notifications
# Leave blank to log notifications to console only
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your_webhook_url_here

# SMTP Configurations for Real Gmail/Email sends (optional, falls back to outbox/ folder logs)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=procurement@yourcompany.com
SMTP_PASSWORD=your_app_password_here
